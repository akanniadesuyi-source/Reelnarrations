
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

:root {
  --bg: #090b12;
  --panel: #121621;
  --panel-light: #191f2d;
  --text: #f5f7ff;
  --muted: #929bad;
  --accent: #a78bfa;
  --accent2: #7c5cff;
  --border: #282f40;
  --green: #63d6a3;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 0%, #242044 0%, transparent 48%),
    var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  padding: 0 18px;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.topbar {
  max-width: 1050px;
  margin: auto;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
}

.brand {
  color: white;
  text-decoration: none;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 800;
  font-size: 21px;
  letter-spacing: -1px;
}

.brand span {
  color: var(--accent);
}

.tag, .eyebrow {
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

main {
  max-width: 850px;
  margin: auto;
}

.hero {
  text-align: center;
  padding: 65px 12px 38px;
}

.hero h1 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: clamp(38px, 8vw, 64px);
  line-height: 1.08;
  letter-spacing: -3px;
  margin: 17px 0;
}

.hero h1 span {
  color: var(--accent);
}

.sub {
  color: var(--muted);
  max-width: 510px;
  margin: auto;
  line-height: 1.7;
  font-size: 14px;
}

.panel {
  background: rgba(18, 22, 33, .96);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 25px;
  margin-bottom: 20px;
  box-shadow: 0 15px 50px rgba(0,0,0,.2);
}

.tabs {
  display: flex;
  gap: 10px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 17px;
  margin-bottom: 22px;
}

.tab {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--muted);
  border-radius: 9px;
  padding: 11px 16px;
  font-size: 13px;
  font-weight: 700;
}

.tab.active {
  color: white;
  background: #292344;
  border-color: var(--accent);
}

.pane {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hidden {
  display: none !important;
}

.dropzone {
  border: 1px dashed #64558f;
  border-radius: 14px;
  min-height: 175px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 9px;
  background: #171827;
  text-align: center;
  padding: 20px;
  cursor: pointer;
}

.dropzone:hover {
  border-color: var(--accent);
  background: #1d1b32;
}

.uploadIcon {
  width: 43px;
  height: 43px;
  border-radius: 12px;
  background: #302650;
  color: var(--accent);
  display: grid;
  place-items: center;
  font-size: 27px;
}

.dropzone strong {
  font-size: 15px;
}

.dropzone span:not(.uploadIcon),
.dropzone small,
.hint {
  color: var(--muted);
  font-size: 12px;
}

.primary {
  width: 100%;
  border: 0;
  border-radius: 10px;
  padding: 15px 18px;
  background: linear-gradient(110deg, #9874ff, #7051e8);
  color: white;
  font-weight: 800;
  font-size: 14px;
  transition: .2s;
}

.primary:hover {
  filter: brightness(1.12);
  transform: translateY(-1px);
}

.primary:disabled {
  opacity: .55;
  cursor: wait;
  transform: none;
}

.field {
  width: 100%;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: #0b0f18;
  color: white;
  outline: none;
}

.field:focus, .script:focus {
  border-color: var(--accent);
}

.status {
  margin-top: 15px;
  color: var(--green);
  font-size: 13px;
  line-height: 1.5;
}

.sectionHead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.sectionHead h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 22px;
  margin-top: 7px;
}

.secondary {
  background: var(--panel-light);
  color: white;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 12px;
  font-weight: 700;
}

.script {
  width: 100%;
  min-height: 270px;
  resize: vertical;
  background: #0b0f18;
  border: 1px solid var(--border);
  border-radius: 12px;
  color: white;
  padding: 17px;
  outline: none;
  font-size: 14px;
  line-height: 1.8;
}

.script::placeholder {
  color: #687184;
}

.voiceRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-top: 20px;
}

.voiceInfo {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.voiceInfo strong {
  font-size: 14px;
}

.voiceInfo span {
  color: var(--muted);
  font-size: 11px;
}

.primary.small {
  width: auto;
  padding: 12px 17px;
}

.audio {
  width: 100%;
  margin-top: 20px;
}

.download {
  display: inline-block;
  margin-top: 14px;
  color: var(--accent);
  font-size: 13px;
}

footer {
  text-align: center;
  color: #71798b;
  font-size: 11px;
  padding: 25px 5px 35px;
}

@media (max-width: 600px) {
  body {
    padding: 0 12px;
  }

  .topbar {
    height: 65px;
  }

  .brand {
    font-size: 18px;
  }

  .tag {
    font-size: 8px;
    letter-spacing: 1px;
  }

  .hero {
    padding: 48px 5px 30px;
  }

  .hero h1 {
    letter-spacing: -2px;
  }

  .panel {
    padding: 17px;
    border-radius: 14px;
  }

  .sectionHead {
    align-items: flex-start;
  }

  .sectionHead h2 {
    font-size: 19px;
  }

  .voiceRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .primary.small {
    width: 100%;
  }
}
